# Only public Ansible runtime source and existing CI dependency inputs.
**
!Dockerfile
!ansible/
ansible/**
!ansible/ansible.cfg
!ansible/.ansible-lint
!ansible/.yamllint
!ansible/requirements*.txt
!ansible/requirements.yml
!ansible/vault-pass.sh
!ansible/playbooks/
ansible/playbooks/**
!ansible/playbooks/workstation.yml
!ansible/roles/
!ansible/roles/**
!ansible/callback_plugins/
!ansible/callback_plugins/**
!ansible/inventory/
ansible/inventory/**
!ansible/inventory/openstrap.yml
!ansible/inventory/group_vars/
ansible/inventory/group_vars/**
!ansible/inventory/group_vars/all/
!ansible/inventory/group_vars/all/**
!ansible/inventory/host_vars/
ansible/inventory/host_vars/**
!ansible/inventory/host_vars/bootstrap-target/
ansible/inventory/host_vars/bootstrap-target/**
!ansible/inventory/host_vars/bootstrap-target/system.yml

# Exclude test tooling and local credentials even beneath allowed directories.
**/molecule/**
**/tests/**
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.vault-pass
**/*.vault-pass
**/id_rsa*
**/id_ed25519*
**/*.pem
**/*.key
